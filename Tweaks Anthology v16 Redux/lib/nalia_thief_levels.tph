/** Installs the full set of Nalia's cre resources for the specified thief level. */
DEFINE_ACTION_FUNCTION a7#install_nalia_cre
INT_VAR
  level = 0 // thief level
STR_VAR
  folder_prefix = ~nalia_lvl~
BEGIN
  OUTER_SPRINT src_path ~Tweaks Anthology v16 Redux/cre/%folder_prefix%%level%~
  ACTION_IF (DIRECTORY_EXISTS ~%src_path%~) BEGIN
    OUTER_SET redux_scs_nalia = 0
    ACTION_CLEAR_ARRAY redux_scs_nalia_scripts
    ACTION_CLEAR_ARRAY redux_scs_nalia_dvs
    ACTION_FOR_EACH cre_resref IN ~nalia8~ ~nalia10~ ~nalia11~ ~nalia13~ ~nalia15~ ~nalia18~ BEGIN
      ACTION_IF (FILE_EXISTS_IN_GAME ~%cre_resref%.cre~) BEGIN
        COPY_EXISTING ~%cre_resref%.cre~ ~override~
          LPF redux#preserve_scs_nalia INT_VAR level RET scs_cre script dv END
          PATCH_IF !scs_cre BEGIN
            LPF a7#fetch_cre_attributes RET_ARRAY cre_numbers cre_strings END
          END
        BUT_ONLY

        ACTION_IF scs_cre BEGIN
          OUTER_SET redux_scs_nalia = 1
          OUTER_SET $redux_scs_nalia_scripts(~%script%~) = 1
          ACTION_TO_LOWER dv
          ACTION_IF (STRING_LENGTH ~%dv%~ > 0 && !~%dv%~ STRING_EQUAL_CASE ~none~) BEGIN
            OUTER_SET $redux_scs_nalia_dvs(~%dv%~) = 1
          END
        END ELSE BEGIN
          COPY ~%src_path%/%cre_resref%.cre~ ~override~
            LPF a7#apply_cre_attributes END
        END
      END
    END

    // SCS owns the level-zero CRE and HP bookkeeping. Keep those resources
    // intact and change its requested dual-class level instead of copying a
    // fully levelled CRE over its scripts and reset effects.
    ACTION_IF redux_scs_nalia BEGIN
      ACTION_PHP_EACH redux_scs_nalia_scripts AS script => present BEGIN
        ACTION_IF FILE_EXISTS_IN_GAME ~%script%.bcs~ BEGIN
          COPY_EXISTING ~%script%.bcs~ ~override~
            DECOMPILE_AND_PATCH BEGIN
              REPLACE_TEXTUALLY CASE_INSENSITIVE ~"dwaulb[0-9]+"~ ~"dwaulb%level%"~
            END
          BUT_ONLY
        END
      END
      COPY_EXISTING ~m_dw_lvd.lua~ ~override~
        PATCH_PHP_EACH redux_scs_nalia_dvs AS dv => present BEGIN
          QUOTE redux_dv_pattern ~%dv%~
          REPLACE_TEXTUALLY CASE_INSENSITIVE ~\(dwLevellerDualClass[ %TAB%]*\[[ %TAB%]*['"]%redux_dv_pattern%['"][ %TAB%]*\][^}]*original_level[ %TAB%]*=[ %TAB%]*\)[0-9]+~ ~\1%level%~
        END
      BUT_ONLY IF_EXISTS
    END
  END ELSE BEGIN
    WARN ~Unsupported creature level: %level%~
  END
END

// Detect the two SCS leveller formats by their own persistent effect sources.
// In the script-based format, the frozen class level is stored in two opcode
// 282 effects. The newer Lua format stores it in m_dw_lvd.lua instead.
DEFINE_PATCH_FUNCTION redux#preserve_scs_nalia
INT_VAR level = 8
RET scs_cre script dv
BEGIN
  SET scs_cre = 0
  READ_ASCII 0x248 script (8) NULL
  READ_ASCII 0x280 dv (32) NULL
  PATCH_IF BYTE_AT 0x33 = 1 BEGIN
    GET_OFFSET_ARRAY redux_nalia_fx CRE_V10_EFFECTS
    PHP_EACH redux_nalia_fx AS index => offset BEGIN
      READ_ASCII (offset + 0x8c) source (8) NULL
      TO_UPPER source
      PATCH_IF (~%source%~ STR_EQ ~DW#AULEL~ ||
                ~%source%~ STR_EQ ~DW#AULE2~ ||
                ~%source%~ STR_EQ ~DW#AULE3~ ||
                ~%source%~ STR_EQ ~DW#DUALC~ ||
                ~%source%~ STR_EQ ~DW#AUSP~) BEGIN
        SET scs_cre = 1
      END
      PATCH_IF (~%source%~ STR_EQ ~DW#DUALC~ &&
                LONG_AT (offset + 0x8) = 282 &&
                (LONG_AT (offset + 0x18) = 8 || LONG_AT (offset + 0x18) = 9)) BEGIN
        WRITE_LONG (offset + 0x14) level
      END
    END
  END
END

// Definitions for numeric cre fields
ACTION_DEFINE_ASSOCIATIVE_ARRAY cre_number_fields BEGIN
  // offset => field_size OR (field_count << 16 | field_size)
  0x08 => 4   // Name
  0x0c => 4   // Tooltip
  0x10 => 4   // Flags
  0x14 => 4   // XP value
  0x18 => 4   // XP
  0x1c => 4   // Gold
  0x20 => 4   // Status
  0x28 => 4   // Animation
  0x2c => 0x070001  // creature colors (7)
  0x44 => 1   // Reputation
  0x59 => 0x0b0001  // resistances (11)
  0x66 => 1   // Lore
  0xa4 => 0x640004  // sound slots (100)
  0x23f => 1  // Morale
  0x240 => 1  // Morale break
  0x242 => 2  // Morale recovery
  0x244 => 4  // Kit
  0x270 => 0x060001 // basic creature attributes (6)
  0x27b => 1  // Alignment
END

// Definitions for cre text fields
ACTION_DEFINE_ASSOCIATIVE_ARRAY cre_string_fields BEGIN
  // offset => field_size OR (field_count << 16 | field_size)
  0x034 => 8  // Small portrait
  0x03c => 8  // Large portrait
  0x248 => 0x050008 // script slots (5)
  0x280 => 32 // Script name
  0x2cc => 8  // Dialog
END

/** Initializes two arrays with selected attributes from the active CRE resource. */
DEFINE_PATCH_FUNCTION a7#fetch_cre_attributes
RET_ARRAY
  cre_numbers   // array of "offset -> numeric value" pairs
  cre_strings   // array of "offset -> string value" pairs
BEGIN
  PATCH_PHP_EACH cre_number_fields AS offset => size BEGIN
    SET offset = offset // hex -> dec conversion
    PATCH_IF (size <= 0xffff) BEGIN
      // single value
      SET count = 1
    END ELSE BEGIN
      // sequence of values
      SET count = size >> 16
      SET size &= 0xffff
    END

    FOR (i = 0; i < count; ++i) BEGIN
      SET ofs = offset + i * size
      PATCH_MATCH size WITH
        1 BEGIN SET $cre_numbers(~%ofs%~) = BYTE_AT ofs END
        2 BEGIN SET $cre_numbers(~%ofs%~) = SHORT_AT ofs END
        4 BEGIN SET $cre_numbers(~%ofs%~) = LONG_AT ofs END
        DEFAULT
      END
    END
  END

  PATCH_PHP_EACH cre_string_fields AS offset => size BEGIN
    SET offset = offset // hex -> dec conversion
    PATCH_IF (size <= 0xffff) BEGIN
      // single value
      SET count = 1
    END ELSE BEGIN
      // sequence of values
      SET count = size >> 16
      SET size &= 0xffff
    END

    FOR (i = 0; i < count; ++i) BEGIN
      SET ofs = offset + i * size
      READ_ASCII ofs value (size) NULL
      SPRINT $cre_strings(~%ofs%~) ~%value%~
    END
  END
END

/** Applies selected attributes to the active CRE resource. */
DEFINE_PATCH_FUNCTION a7#apply_cre_attributes
STR_VAR
  cre_numbers = ~cre_numbers~ // name of the array with "offset -> numeric value" pairs
  cre_strings = ~cre_strings~ // name of the array with "offset -> string value" pairs
BEGIN
  PATCH_PHP_EACH cre_number_fields AS offset => size BEGIN
    SET offset = offset // hex -> dec conversion
    PATCH_IF (size <= 0xffff) BEGIN
      // single value
      SET count = 1
    END ELSE BEGIN
      // sequence of values
      SET count = size >> 16
      SET size &= 0xffff
    END

    FOR (i = 0; i < count; ++i) BEGIN
      SET ofs = offset + i * size
      SET value = $EVAL ~%cre_numbers%~(~%ofs%~)
      PATCH_MATCH size WITH
        1 BEGIN WRITE_BYTE ofs value END
        2 BEGIN WRITE_SHORT ofs value END
        4 BEGIN WRITE_LONG ofs value END
        DEFAULT
      END
    END
  END

  PATCH_PHP_EACH cre_string_fields AS offset => size BEGIN
    SET offset = offset // hex -> dec conversion
    PATCH_IF (size <= 0xffff) BEGIN
      // single value
      SET count = 1
    END ELSE BEGIN
      // sequence of values
      SET count = size >> 16
      SET size &= 0xffff
    END

    FOR (i = 0; i < count; ++i) BEGIN
      SET ofs = offset + i * size
      SPRINT value $EVAL ~%cre_strings%~(~%ofs%~)
      WRITE_ASCIIE ofs ~%value%~ (size)
    END
  END
END
