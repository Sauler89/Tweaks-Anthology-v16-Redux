/////                                                  \\\\\
///// 50% chance to recover after a successful hit,    \\\\\
///// vs. enemies only                                 \\\\\
/////                                                  \\\\\

INCLUDE ~Tweaks Anthology v16 Redux/lib/recoverable_weapons.tpa~

LAF MAKE_AMMO_RECOVERABLE
  INT_VAR
    probability       = 50
    ids_target        = 2
    ids_value         = 200
  STR_VAR
    eff_template_file = ~Tweaks Anthology v16 Redux/eff/a7_hitfx.eff~
END