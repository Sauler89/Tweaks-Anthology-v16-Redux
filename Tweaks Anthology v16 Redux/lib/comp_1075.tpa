ACTION_IF game_is_totsc BEGIN
  INCLUDE ~Tweaks Anthology v16 Redux/lib/bg1areacheck_emulation.tpa~ // clever bit of code from Zed that allows us to check areas; should also work on IWD
  INCLUDE ~Tweaks Anthology v16 Redux/lib/inns.tpa~
END ELSE BEGIN
  WITH_TRA "%tra_location%/english/dw_components.tra" "%tra_location%/%LANGUAGE%/dw_components.tra" BEGIN
    INCLUDE ~Tweaks Anthology v16 Redux/lib/inns_nonbg.tpa~
  END
END
