DEFINE_ACTION_FUNCTION "NWN-STYLE_SUMMONS"
BEGIN
	// lua
	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Rule Changes" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lua\rule_changes\nwn-style_summons.lua" "destRes" = "m_gtrule" END

	//
	ACTION_IF !(FILE_EXISTS_IN_GAME "m_gttbls.lua") BEGIN
		COPY "Tweaks Anthology v16 Redux\luke\lib\resource\tables.lua" "override\m_gttbls.lua"
	END
END

