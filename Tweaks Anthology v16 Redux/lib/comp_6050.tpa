WITH_SCOPE BEGIN
  INCLUDE "Tweaks Anthology v16 Redux\luke\lib\install.tph"
  INCLUDE "Tweaks Anthology v16 Redux\lib\gt_dual_wield.tph"
  //
  WITH_TRA "Tweaks Anthology v16 Redux\languages\english\gt_dual_wield.tra" "Tweaks Anthology v16 Redux\languages\%LANGUAGE%\gt_dual_wield.tra" BEGIN
    LAF "DUAL_WIELD" END
  END
END