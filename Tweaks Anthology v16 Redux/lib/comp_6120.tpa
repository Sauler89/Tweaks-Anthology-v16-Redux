///// Fearless racial feat for Halflings                              \\\\\
/////                                                                 \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////

WITH_SCOPE BEGIN
  INCLUDE "Tweaks Anthology v16 Redux\luke\lib\install.tph"
  INCLUDE "Tweaks Anthology v16 Redux\lib\gt_fearless.tph"
  //
  WITH_TRA "Tweaks Anthology v16 Redux\languages\english\gt_fearless.tra" "Tweaks Anthology v16 Redux\languages\%LANGUAGE%\gt_fearless.tra" BEGIN
    LAF "FEARLESS" END
  END
END