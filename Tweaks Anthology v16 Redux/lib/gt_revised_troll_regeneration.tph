DEFINE_ACTION_FUNCTION "REVISED_TROLL_REGENERATION"
BEGIN
	LAF "ADD_EXTENDED_STAT" STR_VAR "identifier" = "GT_DUMMY_STAT" END
	// lua
	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Misc Tweaks" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lua\tweaks\revised_troll_regeneration.lua" "destRes" = "m_gttwks" END

	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Sprites" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lib\sprite\has_bounce_effects.lua" "destRes" = "m_gtsprt" END
	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Sprites" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lib\sprite\has_immunity_effects.lua" "destRes" = "m_gtsprt" END
	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Sprites" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lib\sprite\has_trap_effect.lua" "destRes" = "m_gtsprt" END

	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Utility Functions / Listeners" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lib\utility\get_effect_fields.lua" "destRes" = "m_gtutil" END
	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Utility Functions / Listeners" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lib\utility\array_contains.lua" "destRes" = "m_gtutil" END

	//
	ACTION_IF !(FILE_EXISTS_IN_GAME "m_gttbls.lua") BEGIN
		COPY "Tweaks Anthology v16 Redux\luke\lib\resource\tables.lua" "override\m_gttbls.lua"
	END
END

