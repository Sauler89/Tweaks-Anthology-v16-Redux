DEFINE_ACTION_FUNCTION "SPELL_PENETRATION"
BEGIN
	LAF "GT_ADD_SPELL"
	INT_VAR
		"level" = 1
		"preferredSlot" = 18
		"type" = 4
	STR_VAR
		"idsName" = "SPELLCASTER_SPELL_PENETRATION"
	RET
		"SPELLCASTER_SPELL_PENETRATION" = "resName"
	END
	//
	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Utility Functions / Listeners" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lib\utility\decode_effect.lua" "destRes" = "m_gtutil" END
	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Utility Functions / Listeners" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lib\utility\decode_spell.lua" "destRes" = "m_gtutil" END
	//
	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Class/Kit Abilities" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lua\class\spell_penetration.lua" "destRes" = "m_gtspcl" END
	LAF "APPEND_LUA_CHUNK" STR_VAR "description" = "Sprites" "sourceFileSpec" = "Tweaks Anthology v16 Redux\luke\lib\sprite\check_ids.lua" "destRes" = "m_gtsprt" END
	//
	ACTION_IF !(FILE_EXISTS_IN_GAME "m_gttbls.lua") BEGIN
		COPY "Tweaks Anthology v16 Redux\luke\lib\resource\tables.lua" "override\m_gttbls.lua"
	END
END