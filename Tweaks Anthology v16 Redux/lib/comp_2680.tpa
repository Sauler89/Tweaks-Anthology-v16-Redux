///// Make Infravision Useful                                                                  \\\\\
/////                                                                                          \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

WITH_SCOPE BEGIN
  INCLUDE "Tweaks Anthology v16 Redux\luke\lib\install.tph"
  //
  INCLUDE "Tweaks Anthology v16 Redux\lib\gt_infravision.tph"
  //
  WITH_TRA "Tweaks Anthology v16 Redux\languages\english\gt_infravision.tra" "Tweaks Anthology v16 Redux\languages\%LANGUAGE%\gt_infravision.tra" BEGIN
    LAF "MAKE_INFRAVISION_USEFUL" END
  END
END