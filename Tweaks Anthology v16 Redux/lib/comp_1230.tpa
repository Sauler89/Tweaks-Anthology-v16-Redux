/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

ACTION_IF NOT MOD_IS_INSTALLED ~Tweaks Anthology v16 Redux/setup-Tweaks Anthology v16 Redux.tp2~ ~1220~ BEGIN

  EXTEND_BOTTOM ~botsmith.bcs~ ~Tweaks Anthology v16 Redux/baf/botsmith.baf~

  COPY_EXISTING ~botsmith.dlg~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      REPLACE_TEXTUALLY ~OR(2)\([%TAB% %LNL%%MNL%%WNL%]*PartyHasItem("blun14")[%TAB% %LNL%%MNL%%WNL%]*PartyHasItem("blun30c")\)~
                        ~OR(3)\1 PartyHasItem("blun30d")~
    END
    BUT_ONLY

  COMPILE ~Tweaks Anthology v16 Redux/dlg/cespy0.d~ // cespenar FoA head order

END

// compiled in serial so that COPY_TRANS will get the one before it
COMPILE ~Tweaks Anthology v16 Redux/dlg/cespy1.d~ // red & shadow dragon scale (bg2ee already has shadow)
COMPILE ~Tweaks Anthology v16 Redux/dlg/cespy2.d~ // ankheg scale
COMPILE ~Tweaks Anthology v16 Redux/dlg/cespy3.d~ // crom faeyr
COMPILE ~Tweaks Anthology v16 Redux/dlg/cespy4.d~ // equalizer
COMPILE ~Tweaks Anthology v16 Redux/dlg/cespy5.d~ // gesen bow
COMPILE ~Tweaks Anthology v16 Redux/dlg/cespy6.d~ // wave halberd
COMPILE ~Tweaks Anthology v16 Redux/dlg/cespy7.d~ // silver sword
COMPILE ~Tweaks Anthology v16 Redux/dlg/cespy8.d~ // mace of disruption

EXTEND_BOTTOM ~botsmith.bcs~ ~Tweaks Anthology v16 Redux/baf/cespy.baf~
